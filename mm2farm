local function ServerHop()

    local placeId = game.PlaceId

    local function FindAndJoinServer()

        local ServerData = HttpService:JSONDecode(game:HttpGet('https://games.roblox.com/v1/games/' .. placeId .. '/servers/Public?sortOrder=Asc&limit=100'))

        

        for index, serverInfo in pairs(ServerData.data) do

            if tonumber(serverInfo.playing) < tonumber(serverInfo.maxPlayers) then

                local TargetServerId = tostring(serverInfo.id)

                TeleportService:TeleportToPlaceInstance(placeId, TargetServerId, game.Players.LocalPlayer)

                task.wait(2)

                return

            end

        end

    end

    

    while true do

        pcall(FindAndJoinServer)

        task.wait(2)

    end

end

local function returncoincontaier()

    for _, v in workspace:GetChildren() do

        if v:FindFirstChild("CoinContainer") and v:IsA("Model") then

            return v:FindFirstChild("CoinContainer")

        end

    end

    return false

end

local CurrentSeason = "Halloween"

local container = returncoincontaier()

