local AutofarmStarted = _G.Settings.AutoFarmToggle

local AutofarmIN = _G.Settings.AutoFarmToggle

local ResetWhenFullBag = _G.Settings.ResetWhenFull

local AutofarmDelay = _G.Settings.Delay

local ServerHopStartTime = os.time()

local RoundActive = false

CoinCollectedEvent.OnClientEvent:Connect(function(cointype, current, max)

    AutofarmIN = true

    if cointype == CurrentCoinType and tonumber(current) == tonumber(max) then

        AutofarmIN = false

        if ResetWhenFullBag and Player.Character then

            Player.Character.Humanoid.Health = 0

        end

    end

end)

local function PcallTP(Position)

    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then

        Player.Character.HumanoidRootPart.CFrame = Position

    end

end

local function FindNearestCoin(container)

    local coin, magn = nil, math.huge

    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then

        return {coin, magn}

    end

    

    local rootPos = Player.Character.HumanoidRootPart.Position

    for _, v in pairs(container:GetChildren()) do

        if v:GetAttribute("CoinID") == CurrentCoinType and v:FindFirstChild("TouchInterest") then

            local dist = (rootPos - v.Position).Magnitude

            if dist < magn then

                coin, magn = v, dist

            end

        end

    end

    return {coin, magn}

end

local function CheckServerHop()

    if _G.Settings.ServerhopToggle and not RoundActive then

        local currentTime = os.time()

        if currentTime - ServerHopStartTime >= _G.Settings.ServerhopTimer then

            ServerHop()

        end

        

        if #Players:GetPlayers() <= 1 then

            ServerHop()

        end

    end

end

spawn(function()

    while true do

        if AutofarmStarted and AutofarmIN and Player.Character and returncoincontaier() then

            local container = returncoincontaier()

            if CurrentSeason == "Halloween" then

                PcallTP(bringpose)

                for _, v in pairs(container:GetChildren()) do

                    if v:GetAttribute("CoinID") == CurrentCoinType and v:FindFirstChild("TouchInterest") then

                        for i = 1,7 do

                            PcallTP(v.CFrame)

                            task.wait(0.03)

                        end

                        break

                    end

                end

                PcallTP(bringpose)

                task.wait(AutofarmDelay)

            else

                local coinData = FindNearestCoin(container)

                if coinData[1] then

                    if coinData[2] > 150 then 

                        PcallTP(coinData[1].CFrame)

                    else

                        local tween = TweenService:Create(Player.Character.HumanoidRootPart, TweenInfo.new(coinData[2] / 20, Enum.EasingStyle.Linear), {CFrame = CFrame.new(coinData[1].Position)})

                        tween:Play()

                        while coinData[1]:FindFirstChild("TouchInterest") do

                            task.wait()

                        end

                        tween:Cancel()

                    end

                end

            end

            CheckServerHop()

        else

            task.wait(0.3)

            CheckServerHop()

        end

    end

end)

RoundStartEvent.OnClientEvent:Connect(function()

    AutofarmIN = true

    RoundActive = true

    if AutofarmStarted and CurrentSeason == "Halloween" and Player.Character then

        Player.Character.HumanoidRootPart.CFrame = bringpose 

    end

end)

RoundEndEvent.OnClientEvent:Connect(function()

    AutofarmIN = false

    RoundActive = false

    CheckServerHop()

end)
